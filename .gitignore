# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.production
# Docker secrets
secrets/

# scratch research artifacts (large scraped dumps — must not be scanned by tailwind or committed)
/local/
/home/

# scratch research artifacts (large scraped dumps — must not be scanned by tailwind or committed)
# botx_docs.html: BotX docs dump with curl auth headers + API keys (gitleaks 35 hits), never commit
botx_docs.html
/local/
/home/

# Playwright / QA run artifacts (regenerated on demand)
/test-results/
/okx-leader-verification.png
/signals-content.webp

# OMC state
.omc/

# OpenCode session runtime data
.omo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
indexer/node_modules/
ws-server/node_modules/
dump.rdb
__pycache__/
/videos/

# IDX harvest snapshots (runtime data, regenerated by npm run harvest:idx-*)
# Written by cron (universe every 6h, saham/brokers/foreign daily, fundamentals
# weekdays) — never commit these batch-replace runtime files.
data/idx/

# CrossEx harvest snapshots (runtime data, regenerated by npm run harvest:crossex)
data/crossex/

# BotX key store (runtime SQLite — contains API keys, never commit)
data/*.sqlite
data/*-journal
# Platform session cookies/tokens (live credentials, never commit)
data/*-session.json

# gamification rollback snapshot (large prod pg_dump — must NOT be committed)
/backup_before_gamification.sql


# Telethon/MTProto userbot session files — live account credentials, never commit
*.session
*.session-journal
# build / test / typecheck logs (artifacts, never commit)
*.out

# zero-issue audit runtime state (mutates on every run, never commit)
data/zero-issue-state.json
data/feed-health-prev.json
data/idx-blocked-until.txt
data/sniper-circuit.json
data/sniper-seen.json
data/sniper-log.json
data/sniper-delivery-log.json
data/sniper-review-seen.json
