data/sniper-phase.json
data/audit-backtest-report.json
data/call-feed-latest.json
data/caller-scores.json
data/wallet-buys-latest.json
data/whale-buys-latest.json
data/whale-wallets-registry.json
data/whale-sheet-sync.json
data/pipeline-heartbeat.json
# cron single-instance run locks (directories, created/removed per pass)
data/.whale-buy-scan.lock/
data/sniper-outcomes.json
data/accumulation-alert-state.json
data/confluence-seen.json
data/confluence-latest.json
data/kolscan-seen.json
data/smartmoney-seen.json
data/call-feed-state.sqlite
data/botx-keys.sqlite

# GMGN tag inventory sweep (runtime artifact, regenerated on demand)
data/gmgn-tag-inventory.json

# nightly DB dumps (large, regenerated — never commit)
backups/

# autoresearch / cron bench logs (regenerated on every run, never commit)
/logs/
/data/forward-test-state.json
/data/forward-test-report.json
/data/signal-backtest-report.json
