# ── NEXUS Terminal — Zero-Config Environment ──────────────────
# All data modules work out of the box with zero API keys.
# The only optional key is ANTHROPIC_API_KEY (user-supplied via Settings UI).

# ── Infrastructure (Docker Compose sets these automatically) ──
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus"
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:4400"
NEXT_PUBLIC_APP_URL="http://localhost:4400"
NEXT_PUBLIC_WS_URL="ws://localhost:4401"
NEXUS_API_KEYS="nexus-dev-key"
POSTGRES_PASSWORD=nexus
LOG_LEVEL=info

# ── Google OAuth (optional — enables "Sign in with Google") ──
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="xxx"
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"
# Requires @auth/prisma-adapter in node_modules (npm i @auth/prisma-adapter)
# before the OAuth flow works end-to-end. The signIn callback + /api/auth/
# nexus-session bridge are already wired — supply these 3 and set the flag.

# ── SMTP Email (optional — enables real verify/reset emails) ──
# Without these, verify/reset emails are only returned as dev-links in
# non-production. Supply all 3 (MAIL_HOST/USER/PASS) to send real emails.
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT=587
# MAIL_SECURE="false"
# MAIL_USER="you@gmail.com"
# MAIL_PASS="app-password"
# MAIL_FROM="Nexus <you@gmail.com>"

# ── Payment Webhook HMAC Secret (required for paid subscriptions) ──
# Shared with 1ai-payment; verify the SAME value there so the subscription
# webhook signs/verifies correctly. Rotate to a random 64-hex string.
# ONEAI_PAYMENT_WEBHOOK_SECRET="change-me"

# ── Telegram Cron Secret (required for cron-triggered broadcasts) ──
# Bearer that /api/v1/telegram/{broadcast,subscribe,alert,personal-alerts}
# accept for server-to-server calls. Rotate to a random 48-hex string.
# TELEGRAM_CRON_SECRET="change-me"


# ── Telegram Bot (optional — for alert delivery) ──────────
# TELEGRAM_BOT_TOKEN="your-bot-token-from-@BotFather"

# ── RPC Overrides (optional — defaults are free public nodes) ─
# ETH_WS_URL=wss://ethereum-rpc.publicnode.com
# ARB_WS_URL=wss://arbitrum-one-rpc.publicnode.com
# BASE_WS_URL=wss://base-rpc.publicnode.com
# OP_WS_URL=wss://optimism-rpc.publicnode.com
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# ── AI Assistant (optional — user supplies via Settings UI) ───
# ANTHROPIC_API_KEY is stored encrypted per-user in the database,
# NOT read from this file. Users enter it at /settings/modules.

# ── FRED API (optional — unlocks all 22 macro series) ─────
# Get your free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without this key: 21/22 series still work (Treasury CSV + World Bank)
# BotX Meme Alpha (optional — free tier: 200K credits/month)
# Get your key: https://dbotx.com/dashboard/dex-api
# BOTX_API_KEY=your-botx-api-key

# ── Stripe Payments (optional — for subscription billing) ─────
# Get your keys: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# ── 1ai-Payment Integration (aggregated payment gateway) ────
# 1ai-payment runs on localhost:3100 and handles all payment providers
# API Key: obtain from 1ai-payment .env (PAYMENT_API_KEY)
ONE_AI_PAYMENT_URL="http://localhost:3100/api"
ONE_AI_PAYMENT_KEY="dev-key-1ai-tracker"

# ── Payment Provider Credentials (managed by 1ai-payment) ──
# These are configured in 1ai-payment, not here. See 1ai-payment/.env
# TRIPAY_API_KEY=...
# TRIPAY_MERCHANT_CODE=...
# MIDTRANS_SERVER_KEY=...
# MIDTRANS_CLIENT_KEY=...
# DUITKU_MERCHANT_CODE=...
# DUITKU_API_KEY=...
# NOWPAYMENTS_API_KEY=...
# NOWPAYMENTS_IPN_SECRET=...

# ── Webhook Callback URL (used by 1ai-payment to call back to project) ──
# Format: https://<your-domain>/api/v1/webhooks/<gateway>
CALLBACK_URL="http://localhost:4400"

# ── IDX Saham Harvest Alerts (optional) ─────────────────────
# Telegram delivery for harvester failure/degradation notices.
# Without these, alerts are logged to the harvest log only.
# TELEGRAM_ALERT_BOT_TOKEN="123456:ABC..."
# TELEGRAM_ALERT_CHAT_ID="123456789"

# ── Realtime IDX Quotes ─────────────────────────────────────
# DEFAULT: Stockbit RE provider — free, keyless (RSC-embedded quotes).
# Optional iTick upgrade below; NOTE its free tier EXCLUDES IDX
# (HK/US/A-shares only) and IDX realtime starts at the paid tiers.
# Unlocks realtime saham quotes; without it the adapter reports
# { enabled:false } and pages fall back to harvested/delayed data.
# https://itick.org
# ITICK_API_KEY="your-itick-key"
# ITICK_QUOTE_URL="https://api.itick.org/rest/quote?symbol={symbol}&market=IDX"
