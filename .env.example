# ── NEXUS Terminal — Environment ─────────────────────────────────
# Copy to .env and fill REQUIRED. Everything else optional (feature-gated).
# Rule: code reads process.env.X — if X is missing here, the buyer cannot
# run the feature. This file lists all 57 vars the code reads (2026-09-22).

# ══ REQUIRED — app will not boot or bill without these ══
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus"
JWT_SECRET="64-hex-chars-min-32-random-bytes"
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:4400"
NEXT_PUBLIC_APP_URL="http://localhost:4400"
SECRETS_MASTER_KEY="64-hex-chars-here"  # 32 random bytes hex; backs up with DB
ONEAI_PAYMENT_API_KEY="dev-key-1ai-tracker"
ONEAI_PAYMENT_BASE_URL="http://localhost:3100"
ONEAI_PAYMENT_WEBHOOK_SECRET="change-me-64-hex"

# ══ INFRASTRUCTURE (Docker Compose / PM2 set these) ══
NEXT_PUBLIC_WS_URL="ws://localhost:4401"
NEXUS_API_KEYS="nexus-dev-key"
NEXUS_WEBHOOK_SECRET="change-me"
POSTGRES_PASSWORD=nexus
LOG_LEVEL=info
NODE_ENV=production
NEXT_RUNTIME=nodejs
DEPLOY_ORIGIN="https://tracker.aitradepulse.com"

# ══ GOOGLE OAUTH (optional — enables "Sign in with Google") ══
# GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="xxx"
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"

# ══ SMTP EMAIL (optional — real verify/reset emails) ══
# Without these, verify/reset links return as dev-links only.
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT=587
# MAIL_SECURE="false"
# MAIL_USER="you@gmail.com"
# MAIL_PASS="app-password"
# MAIL_FROM="Nexus <you@gmail.com>"

# ══ TELEGRAM (optional — alert delivery + cron broadcasts) ══
# TELEGRAM_BOT_TOKEN="from-@BotFather"
# TELEGRAM_CRON_SECRET="48-hex-for-server-to-server"
# TELEGRAM_ALERT_BOT_TOKEN="123456:ABC..."
# TELEGRAM_ALERT_CHAT_ID="123456789"
# FEED_ALERT_CHAT_ID="123456789"
# HUB_TELEGRAM_BOT_TOKEN="hub-brain-bridge-token"
# HUB_TELEGRAM_OWNER_CHAT_ID="123456789"

# ══ MEME SNIPER (optional — live alert pipeline) ══
# Cron scan (npm run cron:sniper) pushes EXECUTE/WATCHLIST alerts to Telegram.
# REJECT never pushes. Same chat chain as TELEGRAM alerts (hub token first).
# SNIPER_DELIVER="true"
# Dedicated sniper bot (@Vilonasnipercoinbot) — takes priority over the hub chain.
# SNIPER_TELEGRAM_BOT_TOKEN="123:ABC..."
# Sale channel. HIGH_CONVICTION always delivers; WATCHLIST/CANDIDATE are
# opt-in per scan (policy D). SNIPER_DELIVER_WATCHLIST="true" enables them
# (labelled "not a top signal") across the cron, realtime bridge, and the
# DEFAULT_DELIVERY_POLICY fallback used by the API routes.
# SNIPER_DELIVER_WATCHLIST="false"
# SNIPER_TELEGRAM_CHAT_ID="123456789"
# Review digest: near-miss REJECTs (real 5m flow) to the operator's private
# chat for manual review. Falls back to HUB_TELEGRAM_OWNER_CHAT_ID /
# TELEGRAM_ADMIN_CHAT_ID when unset. Never point this at the sale channel.
# SNIPER_REVIEW_CHAT_ID="123456789"
# SNIPER_REVIEW_VOLMC_FLOOR="0.5"  # quarter of the new-pair 2x gate
# SNIPER_REVIEW_SEEN_TTL_MS="21600000" # review digest dedupe (default 6h)
# Accumulation phase log (TAHAP 2): one non-UNKNOWN phase per evaluation,
# newest-first, capped 500, keyed by contract. An ACCUMULATION verdict is
# re-alerted to the review chat only when it clears the cooldown window.
# SNIPER_PHASE_PATH="data/sniper-phase.json"
# SNIPER_PHASE_COOLDOWN_MS="21600000" # accumulation re-alert dedupe (default 6h)
# Decision audit trail (Phase 7): one entry per evaluation, newest-first,
# capped 500. A status flip, a changed failure count, or a market-cap move
# beyond 25% marks the contract MATERIAL — the review digest then re-opens
# it even inside the seen-TTL. Runtime state, gitignored like the others.
# SNIPER_AUDIT_PATH="data/sniper-audit.json"
# SNIPER_SCAN_LIMIT="5"        # pairs per pass, clamped 1..10
# Discovery pre-filter (spec C): candidates with a KNOWN market cap below
# the floor, or KNOWN liquidity below the floor, are skipped before audit /
# evaluation / delivery. UNKNOWN (null) values are counted and passed
# through — the evaluator scores them as unproven. Defaults: MC $5,000,
# liquidity $2,000.
# SNIPER_MIN_MARKET_CAP_USD="5000"
# SNIPER_MIN_LIQUIDITY_USD="2000"
# Discovery mode: auto (wallet buys → call feed → API lists, merged) | api
# | call-feed | wallet. Wallet mode runs ONLY wallet-buy discovery —
# useful for proving the wallet→sniper chain in isolation.
# SNIPER_DISCOVER_MODE="auto"
# Trenches sweet-spot discovery (opt-in, DOUBLE gate — BOTH must be "true"):
# the Solpump trenches scanner's PumpFun bonding-curve rows in the [85,100)
# progress window become sniper discovery candidates (additive provider in
# the auto/api discover paths, merged via the same union dedup as the other
# providers). SOLPUMP_TRENCHES_ENABLED is the SHARED fetch flag (also gates
# the dev-history gate's endpoint); SNIPER_TRENCHES_DISCOVERY is the
# sniper-level consumer gate. One flag alone yields no candidates.
# SNIPER_TRENCHES_DISCOVERY="false"
# Solpump HTTP pacing (shared by dev-tokens + trenches adapters, both hit
# trade.solpump.io). The sniper's per-pass fan-out burst-rejects with 400
# (live-proven 2026-10-15), so requests are serialized with a minimum gap
# and transient failures (400/429/5xx/network) are retried with linear
# backoff 1.5s → 3s before the adapter's graceful-degradation fallback.
# SOLPUMP_REQUEST_GAP_MS="700"    # min gap between requests (default 700)
# SOLPUMP_MAX_RETRIES="2"         # retries per request (default 2)
# Dev-history anti-rug pre-gate (opt-in): looks up the dev's historical deploy
# track record via trade.solpump.io BEFORE spending upstream audit calls.
# Serial-scammers (>=3 deploys, 0 migrations) are rejected immediately.
# OFF unless the literal "true".
# SNIPER_DEV_HISTORY_GATE="false"
# Tracked wallets' fresh buys → data/wallet-buys-latest.json via
# npm run cron:wallet-refresh. Freshness cutoff + lookback window (min).
# These shares only matter when SNIPER_DISCOVER_MODE includes wallet.
# WALLET_BUYS_PATH="data/wallet-buys-latest.json"
# WALLET_BUYS_MAX_AGE_MIN="120"
# WALLET_BUYS_WINDOW_MIN="60"
# WALLET_BUYS_DB — DB-primary kill switch for wallet-buy candidates.
# off/false/0 skips all Prisma writes/reads, going straight to JSON.
# WALLET_BUYS_DB="on"
# WALLET_DISCOVERY_MIN_USD="2000"
# Pool rebuild (npm run cron:wallet-discovery, daily 02:17). KOLSCAN-independent:
# GMGN leaderboard sweep + holders of established tokens. No wallet enters the
# tracked pool unless it classifies HUMAN (fastTxRatio, sells>0, >=10 buys).
# Two admission levels, both behind the HUMAN check:
#   QUALIFIED — cleared the §5 bar (wr>=0.6 AND pnl>=0.7, or 30d buy volume
#                >= $250k); may carry signal weight.
#   WATCHLIST — measured and human, but short of the bar: whale-scale volume
#                with a weak win rate, or a high-cap holder position. Tracked
#                for its buys, never quoted as quality.
#               High-cap holders are graded on POSITION SIZE, not pnl:
#               GMGN's /smartmoney/sol/wallet/ endpoint does not report
#               pnl_30d, so pnl-grading that leg rejected 100% of its rows.
# WALLET_DISCOVERY_LIMIT_TOKENS="20"   established tokens to inspect
# WALLET_DISCOVERY_MIN_MC="1000000"    "established" market-cap floor (USD)
# WALLET_DISCOVERY_MIN_WINRATE="0.6"   30d win rate floor
# WALLET_DISCOVERY_MIN_PNL="0.7"       30d PnL floor, as a fraction
# WALLET_DISCOVERY_MAX_FASTTX="0.5"    fastTxRatio at/above this = bot refusal
# WALLET_DISCOVERY_DRY="1"             report only, write nothing
# WALLET_DISCOVERY_MIN_VOLUME="250000"  30d buy-volume floor (USD)
# WALLET_DISCOVERY_CONCURRENCY="6"      parallel GMGN stat calls
# WALLET_DISCOVERY_BUDGET_MS="120000"   wall-clock budget per pass; the pass
#                                       stops measuring and keeps what it has
# WALLET_DISCOVERY_MAX_STAT="150"       stat re-measurements per pass
# WALLET_DISCOVERY_MIN_HOLDER_USD="10000"  min high-cap holder position (USD)
# WALLET_DISCOVERY_MAX_EMPTY="2"        holder leg stops after N empty tokens
#                                       (GMGN serves holders only for pump.fun
#                                       mints; established tokens return none)
#                                       Holders tagged transfer_in are also
#                                       refused: they received the position
#                                       instead of buying it, so the row proves
#                                       custody, not conviction.
# WALLET_DISCOVERY_MAX_429="3"          holder leg stops after N rate-limited
#                                       (HTTP 429) token calls; a blocked pass
#                                       reports them as unchecked, never as
#                                       "no holders"
# Wallet tracer budget per mint (ms). The tracer races the GMGN holder fetch
# (measured 400ms-1s) against this deadline; expiry returns "no evidence"
# instead of a partial trace, so keep it comfortably above the fetch.
# SNIPER_TRACE_BUDGET_MS="20000"
# On-chain RPC fallback for the tracer. OFF unless "true": a single wallet's
# 10-signature harvest measured 212s on the public RPC (429s then -32015),
# so every slow-path trace burned the whole budget for zero buyers. Turn on
# only with a keyed RPC (SOLANA_RPC_URL) in place.
# SNIPER_TRACE_ONCHAIN="false"

# ══ WALLET CLASSIFIER ON-CHAIN FEED (audit item #6) ══
# Wallet swap source for the refresh. "gmgn" (default) uses the keyless
# GMGN wallet-activity feed — real timestamps, token mints and trade-time
# USD — and fills any missing/stale USD legs from the keyless GeckoTerminal
# OHLCV oracle. "rpc" forces the legacy public-RPC harvest (current-price
# only, no historical USD). Any other value falls back to "gmgn".
# WALLET_ACTIVITY_SOURCE="gmgn"
# tx7d is measured for real from the harvested signature list — a proven
# LOWER BOUND (list capped at 200 sigs/wallet), never an exact on-chain total.
# Cluster/wash-trade data is NOT produced by the free public RPC. Default
# false so the classifier records the limitation ("cluster data unavailable").
# Only set "true" if a real cluster source actually produced data.
# CLUSTER_DATA_AVAILABLE="false"
# Persist verified Solana buy legs into the Transaction table. UNSET or
# anything other than "true" = dry-run: the refresh logs how many rows WOULD
# be persisted but writes nothing. Only complete, historically-priced
# SOL→token buys qualify; tokenSymbol is '' (unknown from public RPC) and is
# never fabricated. Upserts are keyed by (chain, txHash), so re-runs are
# idempotent. With WALLET_ACTIVITY_SOURCE=gmgn (default) complete swaps now
# carry historical USD, so "true" yields real Solana Transaction rows.
# PERSIST_SOLANA_TRANSACTIONS="false"
# Execution gate — UNSET or anything other than "true" means the evaluator can
# never return EXECUTE: a setup that passes every hard filter is emitted as
# WATCHLIST instead. Keep this off until the screening rules are operator-
# verified against live tokens (a token's symbol, contract and audit must all
# come from the same mint).
# SNIPER_EXECUTE_ENABLED="false"
# Adaptive delivery policy (TAHAP 4): "true" applies per-tier demotions to
# the live delivery policy. SNIPER_ADAPTIVE_POLICY_DRY_RUN="true" previews
# the same computation (logs "adaptive policy (dry-run): …") while still
# delivering under the base policy — use it before enabling for real.
# SNIPER_ADAPTIVE_POLICY="false"
# SNIPER_ADAPTIVE_POLICY_DRY_RUN="true"
# Realtime sniper bridge (npm run realtime:consumer): WS hype events →
# sniper gates. The ws-server publishes scored tokens to Redis
# (nexus:realtime-sniper); this consumer runs them through the full sniper
# pipeline. OFF unless the literal "true" — the WS alert path is untouched.
# SNIPER_REALTIME_ENABLED="false"
# SNIPER_REALTIME_MAX_EVENTS_PER_MIN="4"   # sliding-window drop, never queue
# SNIPER_REALTIME_COOLDOWN_MS="900000"     # per-contract dedupe (default 15m)
# Outcome closer (npm run cron:meme-price-observer): fetches current Jupiter
# prices for still-PENDING signals older than their 24h horizon and scores
# them. Caps the number of PENDING signals priced per run to keep the
# public Jupiter endpoint polite.
# MEME_OBSERVER_MAX_SIGNALS="25"

# ══ MARKET DATA KEYS (all optional — adapters disable cleanly without) ══
# FRED_API_KEY — unlocks all 22 macro series (21/22 work without)
# FRED_API_KEY="get-free-https://fred.stlouisfed.org/docs/api/api_key.html"
# BOTX_API_KEY — meme screener, free 200K credits/mo (https://dbotx.com)
# BOTX_API_KEY=""
# BOTX_DB — DB mirror kill switch. off/false/0 skips all Prisma writes/reads,
# keeping the credential manager entirely within its SQLite store.
# BOTX_DB="on"
# Meme discovery adapters (optional; each platform disables cleanly without its key/flag)
# MOBY_NANSEN_API_KEY=""
# Nansen optional Bearer-session fallback (ephemeral operator-staged token; apikey wins when set).
# Token ephemeral (~1h), must be a fresh browser privy-token; live viability UNPROVEN — operator runs scripts/nansen-cookie-probe.mjs to test.
# NANSEN_SESSION_PATH="data/nansen-session.json"
# GMGN_SESSION_COOKIE=""
# HOLDER_SOURCE: 'gmgn' (default, cookie-gated, real per-holder PnL via
# GMGN holder list), 'helius' (free 100k credits/mo at helius.xyz, getTokenLargestAccounts,
# address-only source — no PnL, flows to slow-path classifier), or 'auto' (try GMGN first,
# fall back to Helius on empty/error). Default 'gmgn'.
# HOLDER_SOURCE="gmgn"
# Helius API key (free tier 100k credits/mo at helius.xyz). Required only for
# HOLDER_SOURCE=helius or auto fallback. Keyless free public RPC works as fallback
# but is rate-limited; an API key raises the quota substantially.
# HELIUS_API_KEY=""
# FOMO_API_ENABLED="true"
# Alph.ai — keyless public discovery (volume/gainer/graduated) + SEO token audit; opt-in until load-tested.
# ALPH_API_ENABLED="true"
# Solpump X/Twitter KOL event feed (trade.solpump.io, keyless public; verified
# 2026-10-15). Opt-in until load-tested — same pattern as FOMO/ALPH. When on,
# the `solpump` meme platform surfaces tokens mentioned in KOL tweets.
# SOLPUMP_X_ENABLED="true"
# Alphio member API (api.alphio.ai) — Bearer session RE'd from app.alphio.ai.
# No server-side refresh exists (Privy sessions are DPoP key-bound), so stage a
# 45-day access token: ALPHIO_API_KEY=<raw access token> or write
# data/alphio-session.json. Module self-gates and disables cleanly when unset.
# ALPHIO_API_KEY=""
# ALPHIO_SESSION_PATH="data/alphio-session.json"
# AXIOM_API_KEY=""
# MOBY — smart-money screener; prefer MOBY_REFRESH_TOKEN, fallback MOBY_API_KEY
# MOBY_EMAIL="guerrillamail-for-otp-selfheal"
# MOBY_REFRESH_TOKEN="long-lived-privy-refresh-token"
# MOBY_API_KEY="privy-jwt-same-session"
# MOBY_SESSION_PATH="data/moby-session.json"
# MOBY fallback identity — second Privy account used ONLY when the
# primary session can't produce a token (revoked / unconfigured). Same
# seeding rules as the primary (API_KEY+REFRESH_TOKEN from one Privy
# auth response, or EMAIL for OTP self-heal). Optional.
# MOBY_FALLBACK_API_KEY=""
# MOBY_FALLBACK_REFRESH_TOKEN=""
# MOBY_FALLBACK_EMAIL=""
# MOBY_FALLBACK_SESSION_PATH="data/moby-session-fallback.json"
# STOCKBIT_REFRESH_TOKEN — IDX broker flow (or stage via Admin → Integrations)
# STOCKBIT_REFRESH_TOKEN=""
# ITICK_API_KEY / ITICK_QUOTE_URL — realtime IDX quotes (paid tiers for IDX)
# ITICK_API_KEY=""
# ITICK_QUOTE_URL="https://api.itick.org/rest/quote?symbol={symbol}&market=IDX"
# ARKHAM_API_KEY — on-chain entity intel
# ARKHAM_API_KEY=""
# COINMETRICS_API_KEY — on-chain macro
# COINMETRICS_API_KEY=""
# GATE_DEX_API_KEY / GATE_DEX_SECRET_KEY — Gate.io DEX adapter
# GATE_DEX_API_KEY=""
# GATE_DEX_SECRET_KEY=""
# KOL_MONITOR_ENABLED — master gate for cron:kol-monitor (default OFF).
# When not "true", the entire cron (KOLScan feed + Axiom scan + Telegram
# digest) is a no-op. The Axiom digest is always routed to the operator
# review chat (SNIPER_REVIEW_CHAT_ID chain), never the public sale channel.
# KOL_MONITOR_ENABLED="false"
# KOLSCAN_SESSION — kolscan.io `user-session` cookie (Solana KOL wallet feed).
# KOLScan roster + realtime feed are read keyless from public Supabase REST;
# this cookie is OPTIONAL (sent as user-session when set, never gates).
# Downstream gate: purchase >= $1000, wallet 30d win rate >= 60% (GMGN
# leaderboard), and a coordinated-replica filter to drop launcher/bot clusters.
# KOLSCAN_SESSION=""
# KOLSCAN_ENABLED="false"
# Minimum purchase USD for the KOLScan monitor.
# KOLSCAN_MIN_PURCHASE_USD="1000"
# Minimum GMGN 30d win rate (fraction) for the KOLScan monitor.
# KOLSCAN_MIN_WINRATE="0.6"

# ══ WHALE HARVESTER (npm run harvest:whales) ══
# Daily smart-money wallet harvest (GMGN leaderboard + KOLScan roster).
# KOLScan roster read keyless (see KOLSCAN_SESSION above — cookie optional, never gates).
# WHALE_HARVEST_WINDOWS       — comma-separated GMGN windows (default '1d,7d,30d')
# WHALE_HARVEST_KOLSCAN       — 'false' to skip KOLScan (default 'true')
# WHALE_HARVEST_SHEET_ENABLED — 'false' to skip Google Sheet append (default 'true')
# WHALE_HARVEST_WINDOWS="1d,7d,30d"
# WHALE_HARVEST_KOLSCAN="true"
# WHALE_HARVEST_SHEET_ENABLED="true"

# ══ FIRST-SEEN WHALE (npm run cron:wallet-refresh) ══
# Buy legs from never-tracked wallets → Wallet leads (label first-seen-whale).
# Zero extra RPC cost — built from the same harvest as the wallet-buy artifact.
# Minimum single-leg USD to become a signal (default 10000).
# FIRST_SEEN_WHALE_MIN_USD="10000"

# ══ GMGN BOOTSTRAP (npm run bootstrap:gmgn) ══
# Env-free bootstrap job — no configuration needed.

# OMNIROUTE_API_KEY / OMNIROUTE_BASE_URL / OMNIROUTE_MODEL — AI gateway
# OMNIROUTE_API_KEY=""
# OMNIROUTE_BASE_URL="http://localhost:3100"
# OMNIROUTE_MODEL="default"

# ══ REDIS (optional — shared cache across PM2 workers) ══
# Without it, per-process memory cache still works.
# REDIS_URL="redis://localhost:6379"

# ══ PAPER BUY SIMULATION (npm run cron:paper-buy) ══
# Shadow PnL over the sniper outcome log — "had I bought $X at signal time?"
# NO on-chain execution, NO fabricated prices: PnL comes only from forward
# observations the outcome pipeline already recorded. KNOWN LIMITATION: the
# outcome log stores ONE exit price per signal (its own horizon, 24h by
# default), so the sim scores the logged-horizon verdict only; the h1/h4/d7
# breakdown is future work once the observer persists per-horizon data.
# Notional staked per paper position (default 100).
# PAPER_NOTIONAL_USD="100"
# Push the paper summary to the review chat (SNIPER_REVIEW_CHAT_ID chain —
# operator DM, never the public sale channel). Default true.
# PAPER_SEND_SUMMARY="true"

# ══ SMART MONEY CONFLUENCE (npm run cron:confluence) ══
# Live wiring of the pure confluence detector: fetches recent activity per
# qualified (BULLISH) wallet, detects "N qualified wallets bought the same
# token within one window", and pushes ONE compact HTML alert per token to
# the review chat (SNIPER_REVIEW_CHAT_ID chain — operator DM, never the
# public sale channel). OFF unless the literal "true" — same opt-in gate
# pattern as SNIPER_DEV_HISTORY_GATE.
# SNIPER_CONFLUENCE_ENABLED="false"
# CONFLUENCE_WALLET_LIMIT="50"    # wallets per pass (default 50)
# CONFLUENCE_COOLDOWN_MS="21600000" # per-mint alert cooldown (default 6h)
# CONFLUENCE_PREFETCH_DB — DB-primary kill switch for confluence prefetch.
# off/false/0 skips all Prisma writes/reads, going straight to JSON.
# CONFLUENCE_PREFETCH_DB="on"

# ══ WHALE-BUY SCANNER (npm run cron:whale-buy-scan) ══
# Token-first autonomous scanner: discovers candidate tokens (GMGN trending),
# fetches holders + wallet activity per token, and detects whale-sized buys
# (BUY legs with real USD >= WHALE_MIN_USD). Results are written to the
# WalletBuySignal table (source='whale-buy-scanner') + data/whale-buys-latest.json
# and surface as a union member in sniper discoverCombined (all modes).
# WHALE_SCAN_LIMIT="6"              # tokens per pass (default 6). A full pass
#                                   # measured 312s at 6/6 — keep it inside the
#                                   # 10-minute cron slot. Passes overrun with
#                                   # 10/10 and overlapping runs had to be killed.
# WHALE_HOLDER_LIMIT="6"            # holders per token to scan (default 6)
# WHALE_MIN_USD="10000"             # min USD for a whale-sized buy (default 10000; 1000 matches accumulation-alert threshold)
# WHALE_BUYS_DB="on"                # DB kill switch. off/false/0 = JSON only.
# ── Accumulation strategy gates (operator playbook) ───────────
# Alerts now REQUIRE one of three strategies to fire on real MC
# structure (Second Wave / Level Flip / Whale Comeback). A token with
# no firing strategy is logged and dropped, never delivered with an
# entry claim.
# ACCUMULATION_MIN_GUARD_HOLDERS="10"   # min wallets holding (price guard)
# ACCUMULATION_MIN_LIQUIDITY_USD="50000"
# ACCUMULATION_MIN_VOLUME_24H_USD="50000"
# ACCUMULATION_CAPITAL_USD="0"          # 0 = no ladder sizing in the alert
# ACCUMULATION_RISK_PCT="0.01"          # risk per trade (1%)
# ACCUMULATION_MAX_MC_USD="10000000"    # legacy hard cap; per-strategy bands
#                                       # live in strategy-evaluator.ts
# WHALE_BUY_MAX_AGE_MIN="720"       # recency floor for buy legs (minutes, default 720).

# ── Call-group confluence (Telegram call-feed) ────────────────────────────
# How many distinct call groups must have flagged a CA before it is a signal.
# Evidence-only by default: set REQUIRE_CALL_GROUPS>0 to make it a hard gate.
# TRUSTED_ONLY=true counts only the groups named in TRUSTED_CALL_GROUPS.
# Groups are WEIGHTED by measured origin rate (data/caller-scores.json), not
# counted flat: a group that only re-broadcasts other groups cannot corroborate
# a call. Measured 2026-10-22 — with flat counting 22 of 22 multi-group CAs
# cleared a 2-group bar; with weighting only 1 does. Keep the bar off until the
# evidence line reads honestly for the tokens you care about.
# Re-measure weights:   python3 scripts/refetch-call-group-weights.py
#
# VETTED 2026-10-22 from 10,142 contracts / 49,306 mentions over 14d (stable
# at 7d and 30d). Two tests, both required:
#   1. ORIGINATOR — most of its own calls are its own first post, not echoes of
#      another group's post ("leads" vs "echoes" in the state DB).
#   2. INDEPENDENT — in bursts it did not lead, another credit-worthy group
#      corroborated it.
# EXCLUDED and why:
#   CallAnalyser2        leads 74.9% but ONE message per timestamp (7,379
#                        echoes at 1.15 originals per origin-at): a simulator
#                        seeding bursts, not a caller. Never a corroborator.
#   solearlytrending     leads 5.8%, echoes 1,419 (median burst 9) — mirror.
#   SeekrTrending        leads 1.0%, echoes 738 — mirror.
#   KingdomOfDegenCalls  leads 0.5%, echoes 401 — mirror.
#   whaleBuyBotFree      leads 0.1%, echoes 323, 2.3% origination — mirror.
#   gem_tools_calls      leads 0.3%, echoes 120 — mirror.
#   neeyo77xcalls        leads 0.03%, 16 calls total — too small to vet.
#   AlphAI_signals_*     genuinely originate (99.5% / 25.8%) but are BSC/EN
#                        feeds: they never corroborated a Solana call.
#   csolbix              leads 26 / echoes 27 — symmetric, unproven either way;
#                        re-vet after ~100 more calls.
# Observed over the 7d window (6,641 contracts): CallAnalyser 21x, ClubWhaleHunters
# 11x, gamblercallzone 1x as a DISTINCT corroborator of a non-simulator call.
# gamblercallzone is kept only for its 81.5% origination; on one corroboration
# it cannot lift a CA over a 2-group bar by itself. Re-vet in 30d.
ACCUMULATION_TRUSTED_CALL_GROUPS="AlphAI_signals_bsc_en,ClubWhaleHunters,CallAnalyser,gamblercallzone"
# ACCUMULATION_REQUIRE_CALL_GROUPS="0"
# ACCUMULATION_CALL_GROUPS_TRUSTED_ONLY="false"
# WHALE_BUYS_PATH="data/whale-buys-latest.json"  # override JSON artifact path
#
# ── Whale sheet tabs (full rewrite, atomic, change-gated) ──────
# Every pass mirrors the scanner into two operator-sheet tabs. Each rewrite is
# ONE atomic values:batchUpdate (stale tail blanked in the same call), and an
# unchanged payload is skipped entirely via a hash in StateMeta.
# Both `cron:whale-buy-scan` (steps 7-8) and `cron:kol-monitor` write here, so
# WhaleWallets is the union of every scanner — token scanner, KOLScan, Axiom.
# WHALE_SCAN_TAB="WhaleScanner"         # current candidates (6h-pruned window)
# WHALE_WALLET_TAB="WhaleWallets"       # cumulative registry of caught whales
# WHALE_REGISTRY_PATH="data/whale-wallets-registry.json"  # registry artifact
# npm run cron:whale-sheet-sync         # re-push both tabs without a scan

# ══ TOKEN HOLDINGS PERSIST (npm run cron:token-holdings) ══
# Populates TokenHolding from GMGN holder data so resolveCrossTokenContext()
# in accumulation-alert can resolve to cross_token / same_token instead of
# always 'unknown'. Selects tokens with recent whale activity (WalletBuySignal),
# fetches top holders via listGmgnTokenHolders, upserts Wallet+Token+TokenHolding.
# TOKEN_HOLDINGS_ENABLED — master gate (default OFF). When not "true", the
#                         entire cron is a no-op (same pattern as KOL_MONITOR_ENABLED).
# TOKEN_HOLDINGS_ENABLED="true"
# TOKEN_HOLDINGS_LIMIT="15"              # tokens per pass (default 15)
# TOKEN_HOLDINGS_HOLDER_LIMIT="20"       # holders per token to persist (default 20)

# ══ CALL-FEED DB SYNC (npm run sync:call-feed) ══
# Python (scripts/call-feed.py) owns the Telethon harvester + SQLite dedup
# and writes data/call-feed-latest.json. This TS sync step upserts rows into
# the CallFeed Prisma table so sniper-scan can query DB-first.
# CALL_FEED_DB — DB kill switch. off/false/0 skips all Prisma writes/reads.
# CALL_FEED_DB="on"
# CALL_FEED_MAX_AGE_MIN="180"     # staleness gate (min, default 180)

# ══ RPC OVERRIDES (optional — defaults are free public nodes) ══
# ETH_WS_URL=wss://ethereum-rpc.publicnode.com
# ARB_WS_URL=wss://arbitrum-one-rpc.publicnode.com
# BASE_WS_URL=wss://base-rpc.publicnode.com
# OP_WS_URL=wss://optimism-rpc.publicnode.com
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# ══ AI ASSISTANT (optional — per-user via Settings UI, NOT this file) ══
# ANTHROPIC_API_KEY is stored encrypted per-user in DB.

# ══ STRIPE (optional — legacy; live billing runs on 1ai-payment) ══
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ══ CI / DEV ONLY ══
# GITHUB_TOKEN — release scripts only
# RUN_NETWORK_TESTS=1 — include live-network tests (default skips)

# ══ SMART MONEY SYNC (optional — Google Sheets + Telegram alerts) ══
# Uses gog CLI for Google Sheets auth (OAuth token from gog keyring).
# gog must be on PATH and authed: gog auth add <email> --services sheets
# GOG_ACCOUNT=moliangellina@gmail.com
# GOG_KEYRING_PASSWORD=<gog keyring password>
# Sheet reads fall back to public CSV export if gog is unavailable.
# Sheet writes are skipped if gog token extraction fails.
# Telegram alerts fire regardless of Sheet auth status.

# ══ TIDY WHALE SHEET (npm run tidy:whale-sheet) ══
# Writes the DB-sourced tidy whale list to a NEW 'WhaleList_Clean' tab on
# the same smart-money spreadsheet. Never touches existing tabs; re-runs
# rewrite the whole tab so rows never duplicate. Dry-run by default.
# TIDY_WHALE_SHEET_WRITE="true"

# ══ SHEET1 CLEANUP (npm run cleanup:sheet1) ══
# Replaces the noisy first tab (gid=0 'Sheet1') with a single header +
# manual operator rows (non-GMGN names not in the DB leak set) + verified
# DB rows. Destructive path (clear Sheet1, then rewrite) is gated behind:
# SHEET1_CLEANUP_CONFIRM="true"

# ══ LEGACY NAMES (do NOT use — kept so old deploys fail loudly) ══
# ONE_AI_PAYMENT_URL / ONE_AI_PAYMENT_KEY were renamed to
# ONEAI_PAYMENT_BASE_URL / ONEAI_PAYMENT_API_KEY. Old names are IGNORED.
