# ── NEXUS Terminal — Environment ─────────────────────────────────
# Copy to .env and fill REQUIRED. Everything else optional (feature-gated).
# Rule: code reads process.env.X — if X is missing here, the buyer cannot
# run the feature. This file lists all 57 vars the code reads (2026-09-22).

# ══ REQUIRED — app will not boot or bill without these ══
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus"
JWT_SECRET="64-hex-chars-min-32-random-bytes"
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:4400"
NEXT_PUBLIC_APP_URL="http://localhost:4400"
SECRETS_MASTER_KEY="64-hex-chars-here"  # 32 random bytes hex; backs up with DB
ONEAI_PAYMENT_API_KEY="dev-key-1ai-tracker"
ONEAI_PAYMENT_BASE_URL="http://localhost:3100"
ONEAI_PAYMENT_WEBHOOK_SECRET="change-me-64-hex"

# ══ INFRASTRUCTURE (Docker Compose / PM2 set these) ══
NEXT_PUBLIC_WS_URL="ws://localhost:4401"
NEXUS_API_KEYS="nexus-dev-key"
NEXUS_WEBHOOK_SECRET="change-me"
POSTGRES_PASSWORD=nexus
LOG_LEVEL=info
NODE_ENV=production
NEXT_RUNTIME=nodejs
DEPLOY_ORIGIN="https://tracker.aitradepulse.com"

# ══ GOOGLE OAUTH (optional — enables "Sign in with Google") ══
# GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="xxx"
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"

# ══ SMTP EMAIL (optional — real verify/reset emails) ══
# Without these, verify/reset links return as dev-links only.
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT=587
# MAIL_SECURE="false"
# MAIL_USER="you@gmail.com"
# MAIL_PASS="app-password"
# MAIL_FROM="Nexus <you@gmail.com>"

# ══ TELEGRAM (optional — alert delivery + cron broadcasts) ══
# TELEGRAM_BOT_TOKEN="from-@BotFather"
# TELEGRAM_CRON_SECRET="48-hex-for-server-to-server"
# TELEGRAM_ALERT_BOT_TOKEN="123456:ABC..."
# TELEGRAM_ALERT_CHAT_ID="123456789"
# FEED_ALERT_CHAT_ID="123456789"
# HUB_TELEGRAM_BOT_TOKEN="hub-brain-bridge-token"
# HUB_TELEGRAM_OWNER_CHAT_ID="123456789"

# ══ MARKET DATA KEYS (all optional — adapters disable cleanly without) ══
# FRED_API_KEY — unlocks all 22 macro series (21/22 work without)
# FRED_API_KEY="get-free-https://fred.stlouisfed.org/docs/api/api_key.html"
# BOTX_API_KEY — meme screener, free 200K credits/mo (https://dbotx.com)
# BOTX_API_KEY=""
# MOBY — smart-money screener; prefer MOBY_REFRESH_TOKEN, fallback MOBY_API_KEY
# MOBY_EMAIL="guerrillamail-for-otp-selfheal"
# MOBY_REFRESH_TOKEN="long-lived-privy-refresh-token"
# MOBY_API_KEY="privy-jwt-same-session"
# MOBY_SESSION_PATH="data/moby-session.json"
# STOCKBIT_REFRESH_TOKEN — IDX broker flow (or stage via Admin → Integrations)
# STOCKBIT_REFRESH_TOKEN=""
# ITICK_API_KEY / ITICK_QUOTE_URL — realtime IDX quotes (paid tiers for IDX)
# ITICK_API_KEY=""
# ITICK_QUOTE_URL="https://api.itick.org/rest/quote?symbol={symbol}&market=IDX"
# ARKHAM_API_KEY — on-chain entity intel
# ARKHAM_API_KEY=""
# COINMETRICS_API_KEY — on-chain macro
# COINMETRICS_API_KEY=""
# GATE_DEX_API_KEY / GATE_DEX_SECRET_KEY — Gate.io DEX adapter
# GATE_DEX_API_KEY=""
# GATE_DEX_SECRET_KEY=""
# OMNIROUTE_API_KEY / OMNIROUTE_BASE_URL / OMNIROUTE_MODEL — AI gateway
# OMNIROUTE_API_KEY=""
# OMNIROUTE_BASE_URL="http://localhost:3100"
# OMNIROUTE_MODEL="default"

# ══ REDIS (optional — shared cache across PM2 workers) ══
# Without it, per-process memory cache still works.
# REDIS_URL="redis://localhost:6379"

# ══ RPC OVERRIDES (optional — defaults are free public nodes) ══
# ETH_WS_URL=wss://ethereum-rpc.publicnode.com
# ARB_WS_URL=wss://arbitrum-one-rpc.publicnode.com
# BASE_WS_URL=wss://base-rpc.publicnode.com
# OP_WS_URL=wss://optimism-rpc.publicnode.com
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# ══ AI ASSISTANT (optional — per-user via Settings UI, NOT this file) ══
# ANTHROPIC_API_KEY is stored encrypted per-user in DB.

# ══ STRIPE (optional — legacy; live billing runs on 1ai-payment) ══
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ══ CI / DEV ONLY ══
# GITHUB_TOKEN — release scripts only
# RUN_NETWORK_TESTS=1 — include live-network tests (default skips)

# ══ LEGACY NAMES (do NOT use — kept so old deploys fail loudly) ══
# ONE_AI_PAYMENT_URL / ONE_AI_PAYMENT_KEY were renamed to
# ONEAI_PAYMENT_BASE_URL / ONEAI_PAYMENT_API_KEY. Old names are IGNORED.
